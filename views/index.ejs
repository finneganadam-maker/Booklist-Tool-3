<%- include('partials/header') %>

  <main>

    <input type="text" id="suchfeld" placeholder="Bücher durchsuchen..." onkeyup="filterBuecher()">

    <% if (buecher.length === 0) { %>
      <p>Noch keine Bücher in der Liste.</p>
    <% } else { %>
      <ul id="buecherliste">
        <% buecher.forEach(function(buch) { %>
          <li class="buch-eintrag">
            <a href="/buch/<%= buch._id %>"><strong class="buch-titel"><%= buch.titel %></strong></a> von <span class="buch-autor"><%= buch.autor %></span>
            <% if (buch.seiten) { %>
              (<%= buch.seiten %> Seiten)
            <% } %>
            <% if (buch.gelesen) { %>
              <span class="gelesen-badge">✓ gelesen</span>
            <% } else { %>
              <span class="nicht-gelesen">noch nicht gelesen</span>
            <% } %>

            <a href="/buch/<%= buch._id %>/bearbeiten">Bearbeiten</a>

            <form action="/buch/<%= buch._id %>/loeschen" method="POST" style="display:inline" onsubmit="return loeschenBestaetigen()">
              <button type="submit">Löschen</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>

  </main>

<%- include('partials/footer') %>
