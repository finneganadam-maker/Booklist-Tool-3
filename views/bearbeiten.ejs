<%- include('partials/header') %>

  <main>

    <h2>Buch bearbeiten</h2>
    <a href="/">← Zurück zur Liste</a><br><br>

    <% if (typeof errors !== 'undefined') { %>
      <ul class="fehler-liste">
        <% Object.values(errors).forEach(function(e) { %>
          <li><%= e.message %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/buch/<%= buch._id %>/bearbeiten" method="POST">

      <label for="titel">Titel:</label><br>
      <input type="text" id="titel" name="titel" value="<%= buch.titel %>"><br><br>

      <label for="autor">Autor:</label><br>
      <input type="text" id="autor" name="autor" value="<%= buch.autor %>"><br><br>

      <label for="seiten">Seitenanzahl:</label><br>
      <input type="number" id="seiten" name="seiten" value="<%= buch.seiten || '' %>" min="1"><br><br>

      <label>
        <input type="checkbox" name="gelesen" <%= buch.gelesen ? 'checked' : '' %>>
        Bereits gelesen
      </label><br><br>

      <button type="submit">Speichern</button>
      <a href="/">Abbrechen</a>

    </form>

  </main>

<%- include('partials/footer') %>
